              "description": "Max trips to return (default 10).",
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "log_trip",
        "title": "Log a trip",
        "description": "Record a completed eco trip for the signed-in Verden user.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "origin_label": {
              "type": "string",
              "minLength": 1
            },
            "destination_label": {
              "type": "string",
              "minLength": 1
            },
            "origin_lat": {
              "type": "number"
            },
            "origin_lng": {
              "type": "number"
            },
            "dest_lat": {
              "type": "number"
            },
            "dest_lng": {
              "type": "number"
            },
            "distance_km": {
              "type": "number",
              "minimum": 0
            },
            "duration_min": {
              "type": "number",
              "minimum": 0
            },
            "co2_kg": {
              "type": "number",
              "minimum": 0
            },
            "transport_mode": {
              "type": "string",
              "enum": [
                "walk",
                "bike",
                "transit",
                "car",
                "ev"
